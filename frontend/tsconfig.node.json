{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "target": "ES2023",

    "lib": [
      "ES2023"
    ],

    "module": "NodeNext",

    "types": [
      "node"
    ],

    "allowImportingTsExtensions": true,

    "moduleDetection": "force",

    "skipLibCheck": true,

    "noEmit": true,

    "strict": false,

    "noUnusedLocals": false,

    "noUnusedParameters": false,

    "verbatimModuleSyntax": false
  },

  "include": [
    "vite.config.ts"
  ]
}